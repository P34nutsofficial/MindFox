      "roles": [
        {
          "description": "Deine kontrastreiche Querformatansicht zeigt Raumcode, lokale Netzwerkadresse, QR-/Beitrittshinweis, Frage, Countdown, Abstimmung, Auflösung und Rundenzustand aus großer Entfernung gut lesbar.",
          "id": "host_stage",
          "label": "Host- und TV-Bühnenansicht"
        },
        {
          "description": "Deine touchfreundlichen Controller-Ansichten führen übersichtlich durch Beitreten, Warten, Falschantwort mit 75-Zeichen-Limit, Abstimmen ohne eigene Antwort und persönliches Ergebnis.",
          "id": "browser_controller",
          "label": "Fokussierter Browser-Controller"
        },
        {
          "description": "Deine klare Ergebnisdarstellung unterscheidet Wahrheit, Falschantworten, getäuschte Personen und Punkte gut sichtbar und kennzeichnet die doppelte Wertung in Runde 3.",
          "id": "score_reveal",
          "label": "Auflösung und Scoreboard"
        },
        {
          "description": "Deine Oberfläche visualisiert lokale Verbindung, Wiederverbindung, Timeout, automatische Decoy-Antwort, ungültige Eingabe und Neustart mit einfachen engine-nativen Hinweisen.",
          "id": "connection_states",
          "label": "Verbindungs- und Fehlerzustände"
        },
        {
          "description": "Deine Host- und Browseransichten verwenden eine gemeinsame kontrastreiche Farb-, Flächen- und Fokuslogik mit großen Touch-Zielen; vorhandene passende Template-Visuals dürfen unverändert oder angepasst weiterverwendet werden.",
          "id": "party_ui_system",
          "label": "Einheitliches Party-UI-System"
        }
      ]
